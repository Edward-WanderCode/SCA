# === SCA Platform Environment Variables ===

# Application
APP_NAME=SCA Platform
APP_VERSION=2.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://sca_user:sca_password@localhost:5432/sca_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT Authentication (REQUIRED for production!)
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=8

# Scanner Docker Images
OPENGREP_IMAGE=ghcr.io/opengrep/opengrep:latest
TRIVY_IMAGE=aquasecurity/trivy:latest
TRUFFLEHOG_IMAGE=trufflesecurity/trufflehog:latest

# Workspace
SCAN_WORKSPACE_DIR=/app/workspace
MAX_CONCURRENT_SCANS=3

# CORS Origins (comma-separated in config, list in .env not supported — set in config.py)
# For production, update CORS_ORIGINS in config.py or override via environment

# Telegram Notifications & Bot API Server
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_COMMAND_THREAD_ID=306
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Local directory mapping for folder scans (optional)
HOST_CODE_DIR_ON_HOST=./
